# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# ── Supabase ──────────────────────────────────────────────────────────────
# Dashboard → "Connect" button (top bar) → Session pooler → copy the URI.
# Use the SESSION pooler, not Direct connection (IPv6-only on most home ISPs) and
# not Transaction pooler (drops the session features migrations rely on).
# Replace [YOUR-PASSWORD] with the DB password you set when creating the project.
# If the password contains @ : / ? # % or &, URL-encode it (@ → %40, # → %23).
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres

# Always equals https://<PROJECT-REF>.supabase.co — the project ref is the random
# string in your dashboard address bar (/dashboard/project/<PROJECT-REF>).
# Also shown at Project Settings → Data API (newer dashboards) or → API (older).
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co

# Project Settings → API Keys. If you see "publishable"/"secret" instead of
# "anon"/"service_role", open the "Legacy API keys" tab — this code uses those.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — must never be prefixed NEXT_PUBLIC_ or reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── DeepSeek ──────────────────────────────────────────────────────────────
# platform.deepseek.com → API keys
DEEPSEEK_API_KEY=
# Strict tool schemas (the ID-enum grounding contract) require the /beta base URL.
DEEPSEEK_BASE_URL=https://api.deepseek.com/beta
